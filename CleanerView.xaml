<UserControl x:Class="AIGamingOptimizer.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="System Cleaner" FontSize="22" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Temp folders, browser caches, and light Explorer history traces. Locked files are skipped."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Scan Junk" Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Clean Now" Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Estimate}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ListBox ItemsSource="{Binding Details}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
