<UserControl x:Class="AIGamingOptimizer.Views.GameBoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="One-Click Game Boost" Style="{StaticResource PrimaryButton}" Command="{Binding BoostSelectedCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Game Boost" FontSize="22" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="{Binding SafeCount, StringFormat='{}{0} background apps look safe to close. Critical Windows services stay protected.'}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding Processes}" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="Window" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="80"/>
                    <DataGridTextColumn Header="RAM" Binding="{Binding Memory}" Width="90"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="120"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" Margin="4,12,0,0" Text="{Binding Status}" Style="{StaticResource MutedText}"/>
    </Grid>
</UserControl>
