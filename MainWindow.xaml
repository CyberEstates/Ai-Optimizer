<Window x:Class="AIGamingOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:AIGamingOptimizer.ViewModels"
        xmlns:views="clr-namespace:AIGamingOptimizer.Views"
        Title="AI Gaming Optimizer"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameBoostViewModel}">
            <views:GameBoostView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanerViewModel}">
            <views:CleanerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <views:StartupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistantViewModel}">
            <views:AssistantView/>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="#101218" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="AI Gaming Optimizer" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding Clock, StringFormat='  ·  {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeButton}" Content="☐" Click="Maximize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
                            <TextBlock Text="SESSION" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Standard privileges"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Text" Value="Administrator"/>
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="6,18,6,0">
                            <TextBlock Text="NAVIGATE" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="16,0,0,8"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="🏠   Overview"
                                         IsChecked="{Binding Section, Converter={StaticResource StringEquals}, ConverterParameter=overview}"
                                         Command="{Binding NavigateCommand}" CommandParameter="overview" GroupName="nav"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="⚡   Game Boost"
                                         IsChecked="{Binding Section, Converter={StaticResource StringEquals}, ConverterParameter=boost}"
                                         Command="{Binding NavigateCommand}" CommandParameter="boost" GroupName="nav"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="🧹   System Cleaner"
                                         IsChecked="{Binding Section, Converter={StaticResource StringEquals}, ConverterParameter=cleaner}"
                                         Command="{Binding NavigateCommand}" CommandParameter="cleaner" GroupName="nav"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="🚀   Startup &amp; Services"
                                         IsChecked="{Binding Section, Converter={StaticResource StringEquals}, ConverterParameter=startup}"
                                         Command="{Binding NavigateCommand}" CommandParameter="startup" GroupName="nav"/>
                            <RadioButton Style="{StaticResource NavButton}" Content="🤖   AI Assistant"
                                         IsChecked="{Binding Section, Converter={StaticResource StringEquals}, ConverterParameter=assistant}"
                                         Command="{Binding NavigateCommand}" CommandParameter="assistant" GroupName="nav"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="22"/>
            </Grid>
        </Grid>
    </Border>
</Window>
