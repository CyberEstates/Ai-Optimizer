<UserControl x:Class="AIGamingOptimizer.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIGamingOptimizer.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="16" Background="#220EA5E9" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Snapshot.HealthScore}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM HEALTH" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Snapshot.HealthSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Text="{Binding Snapshot.OsName, StringFormat='Running on {0}'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="LIVE GAUGES" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3">
                        <controls:CircularGauge Height="96" Percent="{Binding Snapshot.CpuPercent}" Label="CPU"/>
                        <controls:CircularGauge Height="96" Percent="{Binding Snapshot.GpuPercent}" Label="GPU"/>
                        <controls:CircularGauge Height="96" Percent="{Binding Snapshot.RamPercent}" Label="RAM"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" FontSize="11"
                               Text="{Binding Snapshot.CpuName}"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11"
                               Text="{Binding Snapshot.GpuName}"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11"
                               Text="{Binding Snapshot.RamUsedGb, StringFormat='RAM {0:0.0} GB used'}"/>
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Modules}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                                <TextBlock Text="{Binding Stat}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="Include in Optimize Now" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Analyze System" Style="{StaticResource GhostButton}" Command="{Binding AnalyzeCommand}" Margin="0,0,10,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Optimize Now" Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                               Text="{Binding Snapshot.PowerPlan, StringFormat='Power plan · {0}'}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
