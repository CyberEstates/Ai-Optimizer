<UserControl x:Class="AIGamingOptimizer.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="Gaming Power Plan" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyGamingPlanCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Startup &amp; Services" FontSize="22" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}"/>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding PowerPlan, StringFormat='Active power plan · {0}'}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
